// Prisma schema for 登録支援機関DX
// 多点・他国間・多言語プラットフォーム

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== テナント・組織管理 ====================

model Tenant {
  id                 String   @id @default(cuid())
  name               String
  registrationNumber String   @unique // 登録番号
  status             String   @default("active") // active, suspended, pending
  timezone           String   @default("Asia/Tokyo")
  defaultLanguage    String   @default("ja")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  orgUnits          OrgUnit[]
  users             User[]
  roles             Role[]
  companies         Company[]
  foreignWorkers    ForeignWorker[]
  supportPlans      SupportPlan[]
  interviews        Interview[]
  consultations     Consultation[]
  documentTemplates DocumentTemplate[]
  documentInstances DocumentInstance[]
  auditLogs         AuditLog[]

  @@map("tenants")
}

// 組織単位（階層構造: 支店 > チーム > 担当者グループなど）
model OrgUnit {
  id        String   @id @default(cuid())
  tenantId  String
  parentId  String?  // 親組織（nullの場合はルート）
  name      String
  code      String
  type      String   // branch, team, group
  level     Int      @default(0) // 階層レベル
  // 住所（支店の場合）
  postalCode String?
  prefecture String?
  city       String?
  street     String?
  building   String?
  country    String   @default("JP")
  timezone   String   @default("Asia/Tokyo")
  status     String   @default("active") // active, inactive
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   OrgUnit?  @relation("OrgUnitHierarchy", fields: [parentId], references: [id])
  children OrgUnit[] @relation("OrgUnitHierarchy")
  memberships Membership[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([parentId])
  @@map("org_units")
}

// ==================== ユーザー・権限管理 ====================

model Role {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  code        String   // RSO_ADMIN, RSO_MANAGER, RSO_STAFF, RSO_AUDITOR, COMPANY_ADMIN, COMPANY_HR, LEGAL_STAFF, LEGAL_VIEWER
  description String?
  permissions String[] // 権限リスト
  isSystem    Boolean  @default(false) // システム定義ロール（変更不可）
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships Membership[]

  @@unique([tenantId, code])
  @@map("roles")
}

model User {
  id                String    @id @default(cuid())
  tenantId          String
  companyId         String?   // 受入企業/士業ユーザー用
  email             String    @unique
  passwordHash      String
  name              String
  nameKana          String?
  status            String    @default("active") // active, inactive, pending
  preferredLanguage String    @default("ja")
  timezone          String    @default("Asia/Tokyo")
  twoFactorEnabled  Boolean   @default(false)
  twoFactorSecret   String?
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id])

  memberships              Membership[]
  assignedTasks            SupportTask[]            @relation("TaskAssignee")
  createdTasks             SupportTask[]            @relation("TaskCreator")
  conductedInterviews      Interview[]              @relation("Interviewer")
  interpretedInterviews    Interview[]              @relation("Interpreter")
  receivedConsultations    Consultation[]           @relation("ConsultationReceiver")
  assignedConsultations    Consultation[]           @relation("ConsultationAssignee")
  consultationResponses    ConsultationResponse[]
  createdDocuments         DocumentInstance[]       @relation("DocumentCreator")
  approvedDocuments        DocumentInstance[]       @relation("DocumentApprover")
  createdSupportPlans      SupportPlan[]            @relation("SupportPlanCreator")
  approvedSupportPlans     SupportPlan[]            @relation("SupportPlanApprover")
  uploadedEvidence         Evidence[]

  @@index([tenantId])
  @@index([email])
  @@map("users")
}

// ユーザーと組織・ロールの紐付け
model Membership {
  id        String   @id @default(cuid())
  userId    String
  orgUnitId String?  // null の場合はテナント全体
  roleId    String
  isPrimary Boolean  @default(false) // 主所属
  startDate DateTime @default(now())
  endDate   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgUnit OrgUnit? @relation(fields: [orgUnitId], references: [id])
  role    Role    @relation(fields: [roleId], references: [id])

  @@unique([userId, orgUnitId, roleId])
  @@index([userId])
  @@index([orgUnitId])
  @@map("memberships")
}

// ==================== 受入企業管理 ====================

model Company {
  id                String    @id @default(cuid())
  tenantId          String
  name              String
  nameKana          String?
  corporateNumber   String?   // 法人番号
  industry          String
  status            String    @default("active") // active, inactive, pending
  contractStartDate DateTime
  contractEndDate   DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  offices        CompanyOffice[]
  foreignWorkers ForeignWorker[]
  users          User[]
  staff          Staff[]
  consultations  Consultation[]

  @@index([tenantId])
  @@map("companies")
}

model CompanyOffice {
  id             String   @id @default(cuid())
  companyId      String
  name           String
  postalCode     String?
  prefecture     String?
  city           String?
  street         String?
  building       String?
  country        String   @default("JP")
  phone          String?
  fax            String?
  isHeadquarters Boolean  @default(false)
  status         String   @default("active") // active, inactive
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company        Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  foreignWorkers ForeignWorker[]
  staff          Staff[]

  @@map("company_offices")
}

// 受入企業のスタッフ（担当者）
model Staff {
  id            String   @id @default(cuid())
  companyId     String
  officeId      String?
  name          String
  nameKana      String?
  position      String?
  department    String?
  email         String?
  phone         String?
  role          String   // admin, hr, supervisor, viewer
  isMainContact Boolean  @default(false)
  status        String   @default("active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  office  CompanyOffice? @relation(fields: [officeId], references: [id])

  @@index([companyId])
  @@map("staff")
}

// ==================== 外国人（支援対象者）管理 ====================

model ForeignWorker {
  id                  String   @id @default(cuid())
  tenantId            String
  companyId           String
  officeId            String?
  // 基本情報
  firstName           String
  lastName            String
  firstNameKana       String?
  lastNameKana        String?
  firstNameNative     String?  // 母語表記
  lastNameNative      String?
  dateOfBirth         DateTime
  gender              String   // male, female, other
  nationality         String
  // 連絡先
  email               String?
  phone               String
  postalCode          String?
  prefecture          String?
  city                String?
  street              String?
  building            String?
  country             String   @default("JP")
  // 緊急連絡先
  emergencyName       String?
  emergencyRelation   String?
  emergencyPhone      String?
  // 言語
  nativeLanguage      String
  understandsLanguages String[]
  japaneseLevel       String?  // N1-N5, none
  // 在留関連
  residenceCardNumber String
  residenceStatus     String   // 在留資格
  residencePeriod     String   // 在留期間
  residenceExpiry     DateTime // 在留期限
  residenceIssueDate  DateTime
  // ステータス
  status              String   @default("active") // active, completed, suspended, terminated
  supportStartDate    DateTime
  supportEndDate      DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company  Company        @relation(fields: [companyId], references: [id])
  office   CompanyOffice? @relation(fields: [officeId], references: [id])

  employmentContracts EmploymentContract[]
  supportPlans        SupportPlan[]
  supportTasks        SupportTask[]
  interviews          Interview[]
  consultations       Consultation[]
  documentInstances   DocumentInstance[]
  alerts              WorkerAlert[]

  @@index([tenantId])
  @@index([companyId])
  @@index([residenceExpiry])
  @@map("foreign_workers")
}

// 雇用契約（履歴管理）
model EmploymentContract {
  id                  String    @id @default(cuid())
  foreignWorkerId     String
  contractNumber      String?
  // 契約期間
  startDate           DateTime
  endDate             DateTime?
  // 業務内容
  jobCategory         String    // 業種
  occupation          String    // 職種
  jobDescription      String?
  // 給与
  salary              Int
  salaryType          String    // monthly, hourly, daily
  currency            String    @default("JPY")
  // 労働条件
  workingHoursPerWeek Float
  workingDaysPerWeek  Int?
  overtimeAllowed     Boolean   @default(true)
  // 福利厚生
  socialInsurance     Boolean   @default(true)
  employmentInsurance Boolean   @default(true)
  // ステータス
  status              String    @default("active") // active, terminated, renewed
  terminationReason   String?
  terminatedAt        DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  foreignWorker ForeignWorker @relation(fields: [foreignWorkerId], references: [id], onDelete: Cascade)

  @@index([foreignWorkerId])
  @@map("employment_contracts")
}

model WorkerAlert {
  id              String   @id @default(cuid())
  foreignWorkerId String
  type            String   // residence_expiry, contract_expiry, interview_due, document_due, custom
  message         String
  dueDate         DateTime
  status          String   @default("pending") // pending, acknowledged, resolved
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  foreignWorker ForeignWorker @relation(fields: [foreignWorkerId], references: [id], onDelete: Cascade)

  @@index([foreignWorkerId])
  @@index([dueDate])
  @@map("worker_alerts")
}

// ==================== 支援計画 ====================

model SupportPlanTemplate {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  isDefault   Boolean  @default(false)
  status      String   @default("draft") // draft, active, archived
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  SupportPlanItemTemplate[]
  plans  SupportPlan[]

  @@map("support_plan_templates")
}

model SupportPlanItemTemplate {
  id                      String   @id @default(cuid())
  templateId              String
  itemNumber              Int      // 1-10
  category                String   // pre_entry, arrival, living, japanese_learning, consultation, community, career, regular_interview
  title                   String
  titleTranslations       Json     // { "en": "...", "vi": "..." }
  description             String
  descriptionTranslations Json
  defaultMethod           String?
  requiredDocuments       String[]
  requiresConsent         Boolean  @default(false)
  frequency               String?  // once, monthly, quarterly, yearly, as_needed
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  template SupportPlanTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, itemNumber])
  @@map("support_plan_item_templates")
}

model SupportPlan {
  id              String    @id @default(cuid())
  tenantId        String
  foreignWorkerId String
  templateId      String?
  status          String    @default("draft") // draft, pending_approval, active, completed, cancelled
  startDate       DateTime
  endDate         DateTime?
  createdBy       String
  approvedBy      String?
  approvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  foreignWorker ForeignWorker        @relation(fields: [foreignWorkerId], references: [id])
  template      SupportPlanTemplate? @relation(fields: [templateId], references: [id])
  creator       User                 @relation("SupportPlanCreator", fields: [createdBy], references: [id])
  approver      User?                @relation("SupportPlanApprover", fields: [approvedBy], references: [id])
  items         SupportPlanItem[]

  @@index([tenantId])
  @@index([foreignWorkerId])
  @@map("support_plans")
}

model SupportPlanItem {
  id          String   @id @default(cuid())
  planId      String
  itemNumber  Int
  category    String
  title       String
  description String
  method      String?
  customNotes String?
  status      String   @default("pending") // pending, in_progress, completed, skipped
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  plan  SupportPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  tasks SupportTask[]

  @@unique([planId, itemNumber])
  @@map("support_plan_items")
}

model SupportTask {
  id                String    @id @default(cuid())
  planItemId        String
  foreignWorkerId   String
  assigneeId        String
  createdById       String
  title             String
  description       String?
  dueDate           DateTime
  completedAt       DateTime?
  method            String?
  status            String    @default("pending") // pending, in_progress, completed, cancelled, overdue
  priority          String    @default("medium") // low, medium, high, urgent
  // 本人同意
  consentRequired   Boolean   @default(false)
  consentObtainedAt DateTime?
  consentMethod     String?   // written, electronic, verbal
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  planItem      SupportPlanItem @relation(fields: [planItemId], references: [id], onDelete: Cascade)
  foreignWorker ForeignWorker   @relation(fields: [foreignWorkerId], references: [id])
  assignee      User            @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creator       User            @relation("TaskCreator", fields: [createdById], references: [id])
  evidence      Evidence[]

  @@index([assigneeId])
  @@index([dueDate])
  @@index([status])
  @@map("support_tasks")
}

// ==================== 証跡（添付ファイル）====================

model Evidence {
  id            String   @id @default(cuid())
  taskId        String?
  interviewId   String?
  consultationId String?
  documentId    String?
  // ファイル情報
  fileName      String
  fileType      String   // image, pdf, document, other
  mimeType      String
  fileSize      Int      // bytes
  fileUrl       String
  // メタデータ
  description   String?
  category      String?  // consent, signature, photo, record, other
  uploadedById  String
  uploadedAt    DateTime @default(now())
  createdAt     DateTime @default(now())

  task         SupportTask?      @relation(fields: [taskId], references: [id], onDelete: SetNull)
  interview    Interview?        @relation(fields: [interviewId], references: [id], onDelete: SetNull)
  consultation Consultation?     @relation(fields: [consultationId], references: [id], onDelete: SetNull)
  document     DocumentInstance? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  uploadedBy   User              @relation(fields: [uploadedById], references: [id])

  @@index([taskId])
  @@index([interviewId])
  @@index([consultationId])
  @@map("evidence")
}

// ==================== 定期面談 ====================

model Interview {
  id                String    @id @default(cuid())
  tenantId          String
  foreignWorkerId   String
  // 予定
  scheduledDate     DateTime
  scheduledTime     String?
  location          String?
  locationType      String    @default("in_person") // in_person, video, phone
  timezone          String    @default("Asia/Tokyo")
  // 担当
  interviewerId     String
  interpreterId     String?
  // 実施
  actualDate        DateTime?
  actualTime        String?
  duration          Int?      // 分
  conductedLanguage String?
  // 記録
  status            String    @default("scheduled") // scheduled, confirmed, completed, cancelled, no_show, rescheduled
  summary           String?
  followUpRequired  Boolean   @default(false)
  followUpNotes     String?
  createdBy         String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  foreignWorker ForeignWorker    @relation(fields: [foreignWorkerId], references: [id])
  interviewer   User             @relation("Interviewer", fields: [interviewerId], references: [id])
  interpreter   User?            @relation("Interpreter", fields: [interpreterId], references: [id])
  topics        InterviewTopic[]
  issues        InterviewIssue[]
  evidence      Evidence[]

  @@index([tenantId])
  @@index([foreignWorkerId])
  @@index([scheduledDate])
  @@map("interviews")
}

model InterviewTopic {
  id             String  @id @default(cuid())
  interviewId    String
  category       String  // work_conditions, living_conditions, health, japanese_learning, community, concerns, other
  title          String
  content        String
  workerResponse String?

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@map("interview_topics")
}

model InterviewIssue {
  id          String    @id @default(cuid())
  interviewId String
  title       String
  description String
  severity    String    // low, medium, high, critical
  status      String    @default("open") // open, in_progress, resolved, escalated
  resolution  String?
  resolvedAt  DateTime?

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@map("interview_issues")
}

// ==================== 相談・苦情 ====================

model Consultation {
  id               String    @id @default(cuid())
  tenantId         String
  foreignWorkerId  String
  companyId        String
  // 受付情報
  category         String    // work_conditions, harassment, wage, living, health, visa, family, other
  subject          String
  description      String
  receivedAt       DateTime  @default(now())
  receivedById     String
  receivedMethod   String    // phone, email, in_person, app, other
  // 言語
  language         String
  interpreterId    String?
  interpreterNotes String?
  // ステータス
  status           String    @default("received") // received, in_progress, pending_response, resolved, closed, escalated
  priority         String    @default("medium") // low, medium, high, urgent
  // 対応
  assigneeId       String?
  dueDate          DateTime?
  // クローズ
  resolution       String?
  closedAt         DateTime?
  closedById       String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant        Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  foreignWorker ForeignWorker            @relation(fields: [foreignWorkerId], references: [id])
  company       Company                  @relation(fields: [companyId], references: [id])
  receivedBy    User                     @relation("ConsultationReceiver", fields: [receivedById], references: [id])
  assignee      User?                    @relation("ConsultationAssignee", fields: [assigneeId], references: [id])
  responses     ConsultationResponse[]
  escalations   ConsultationEscalation[]
  evidence      Evidence[]

  @@index([tenantId])
  @@index([foreignWorkerId])
  @@index([status])
  @@map("consultations")
}

model ConsultationResponse {
  id             String   @id @default(cuid())
  consultationId String
  responderId    String
  content        String
  language       String
  createdAt      DateTime @default(now())

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  responder    User         @relation(fields: [responderId], references: [id])

  @@map("consultation_responses")
}

model ConsultationEscalation {
  id             String   @id @default(cuid())
  consultationId String
  escalatedById  String
  escalatedToId  String
  reason         String
  createdAt      DateTime @default(now())

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@map("consultation_escalations")
}

// ==================== 書類管理 ====================

model DocumentTemplate {
  id                  String    @id @default(cuid())
  tenantId            String
  name                String
  description         String?
  category            String    // support_plan, employment, immigration, interview, consultation, notification, other
  format              String    // html, pdf, excel
  content             String    // HTML/Mustacheテンプレート
  contentTranslations Json      // { "en": "...", "vi": "..." }
  variables           Json      // TemplateVariable[]
  requiredFields      String[]  // 必須項目リスト
  version             Int       @default(1)
  status              String    @default("draft") // draft, active, archived
  approvedById        String?
  approvedAt          DateTime?
  isLegalDocument     Boolean   @default(false)
  legalTextVersion    String?
  createdById         String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  instances DocumentInstance[]

  @@map("document_templates")
}

model DocumentInstance {
  id               String    @id @default(cuid())
  tenantId         String
  templateId       String
  foreignWorkerId  String?
  companyId        String?
  // 内容
  title            String
  language         String
  variables        Json      // Record<string, unknown>
  // 生成
  generatedFileUrl String?
  generatedAt      DateTime?
  // 版管理
  version          Int       @default(1)
  versionType      String    @default("original") // original, revision, resubmission, returned
  parentVersionId  String?
  // 不備チェック
  validationStatus String    @default("pending") // pending, valid, invalid
  validationErrors Json?     // ValidationError[]
  // 承認
  status           String    @default("draft") // draft, pending_review, pending_approval, approved, rejected, submitted, returned
  approvedById     String?
  approvedAt       DateTime?
  // 提出
  submittedAt      DateTime?
  submittedById    String?
  // メタ
  createdById      String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template      DocumentTemplate @relation(fields: [templateId], references: [id])
  foreignWorker ForeignWorker?   @relation(fields: [foreignWorkerId], references: [id])
  creator       User             @relation("DocumentCreator", fields: [createdById], references: [id])
  approver      User?            @relation("DocumentApprover", fields: [approvedById], references: [id])
  versions      DocumentVersion[]
  evidence      Evidence[]

  @@index([tenantId])
  @@index([foreignWorkerId])
  @@index([status])
  @@map("document_instances")
}

model DocumentVersion {
  id          String   @id @default(cuid())
  documentId  String
  version     Int
  versionType String   // original, revision, resubmission, returned
  fileUrl     String
  changes     String?
  createdById String
  createdAt   DateTime @default(now())

  document DocumentInstance @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("document_versions")
}

// ==================== 監査ログ（追記のみ）====================

model AuditLog {
  id           String   @id @default(cuid())
  tenantId     String
  userId       String
  userRole     String
  userEmail    String
  timestamp    DateTime @default(now())
  // アクション
  action       String   // create, read, update, delete, approve, reject, submit, export, login, logout, permission_change
  resource     String   // user, foreign_worker, company, support_plan, support_task, interview, consultation, document, template, tenant, org_unit
  resourceId   String
  resourceName String?
  // コンテキスト
  ipAddress    String
  userAgent    String
  orgUnitId    String?  // 操作時の所属組織
  // 詳細
  details      Json     // { before: {...}, after: {...}, reason: "..." }
  status       String   // success, failure
  errorMessage String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // 監査ログは削除不可のためonDeleteなし
  @@index([tenantId])
  @@index([userId])
  @@index([timestamp])
  @@index([resource, resourceId])
  @@map("audit_logs")
}
