{
  "name": "nintei",
  "version": "0.1.0",
  "private": true,
  "description": "登録支援機関DX - 多点・他国間・多言語プラットフォーム",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:api": "pnpm --filter @nintei/api dev",
    "dev:web": "pnpm --filter @nintei/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "test": "pnpm -r test",
    "test:unit": "pnpm --filter @nintei/api test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:generate": "pnpm --filter @nintei/api prisma:generate",
    "db:migrate": "pnpm --filter @nintei/api prisma:migrate",
    "db:seed": "pnpm --filter @nintei/api prisma:seed",
    "db:studio": "pnpm --filter @nintei/api prisma:studio",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "clean": "pnpm -r clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^20.17.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0"
  }
}
